// Archivo de prueba para la sentencia SWITCH-CASE

System.out.println("--- Pruebas para SWITCH ---");

// --- Prueba 1: Caso simple con break ---
int dia = 4;
String nombreDia = "No definido";

switch (dia) {
    case 1:
        nombreDia = "Lunes";
        break;
    case 2:
        nombreDia = "Martes";
        break;
    case 3:
        nombreDia = "Miércoles";
        break;
    case 4:
        nombreDia = "Jueves"; // Debe entrar aquí
        break;
    case 5:
        nombreDia = "Viernes";
        break;
    default:
        nombreDia = "Fin de semana";
        break;
}
System.out.println("Prueba 1: El día 4 es " + nombreDia);
System.out.println("");


// --- Prueba 2: Comportamiento "Fall-Through" (sin break) ---
char vocal = 'i';
String tipoVocal = "";

switch (vocal) {
    case 'a':
    case 'e':
    case 'i': // Entra aquí...
    case 'o': // ...y como no hay break, sigue ejecutando...
    case 'u': // ...hasta aquí.
        tipoVocal = "Es una vocal minúscula";
        break;
    case 'A':
    case 'E':
    case 'I':
    case 'O':
    case 'U':
        tipoVocal = "Es una vocal mayúscula";
        break;
}
System.out.println("Prueba 2: La letra 'i' " + tipoVocal);
System.out.println("");


// --- Prueba 3: Caso "default" ---
String animal = "perro";
String categoria = "";

switch (animal) {
    case "gato":
        categoria = "Felino";
        break;
    case "leon":
        categoria = "Felino";
        break;
    case "tigre":
        categoria = "Felino";
        break;
    default:
        categoria = "Categoría no encontrada"; // Debe entrar aquí
        break;
}
System.out.println("Prueba 3: Un perro es de la " + categoria);