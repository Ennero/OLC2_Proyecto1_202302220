// Pruebas para nuevas features de casteos, chars y concatenación

// 1. Concatenación de strings
string str1 = "Hola, ";
string str2 = "Mundo!";
System.out.println(str1 + str2); // Esperado: Hola, Mundo!

// 2. Concatenación de string con otros tipos
int num1 = 123;
double dbl1 = 45.67;
boolean bool1 = true;
char chr1 = 'A';

System.out.println("El número es: " + num1);      // Esperado: El número es: 123
System.out.println(dbl1 + " es un decimal.");    // Esperado: 45.670000 es un decimal.
System.out.println("El valor booleano es " + bool1); // Esperado: El valor booleano es true
System.out.println("El caracter es: " + chr1);      // Esperado: El caracter es: A

// 3. Impresión de Chars
char chr2 = 'X';
System.out.println(chr2); // Esperado: X

// 4. Aritmética de Chars (debería funcionar como con ints)
char chr3 = 'A' + 1;
System.out.println(chr3); // Esperado: B (ASCII 66)

// 5. Casteo explícito a String
int num2 = 789;
string str3 = (string) num2;
System.out.println("Número casteado a string: " + str3); // Esperado: Número casteado a string: 789

double dbl2 = -98.76;
string str4 = (string) dbl2;
System.out.println("Double casteado a string: " + str4); // Esperado: Double casteado a string: -98.760000

// 6. Casteo explícito entre numéricos y char
int num3 = 65;
char chr4 = (char) num3;
System.out.println("Número 65 casteado a char: " + chr4); // Esperado: Número 65 casteado a char: A

char chr5 = 'Z';
int num4 = (int) chr5;
System.out.println("Char 'Z' casteado a int: " + num4); // Esperado: Char 'Z' casteado a int: 90

double dbl3 = 66.7;
char chr6 = (char) dbl3;
System.out.println("Double 66.7 casteado a char: " + chr6); // Esperado: Double 66.7 casteado a char: B
