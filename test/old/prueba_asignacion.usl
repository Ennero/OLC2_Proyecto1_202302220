// Archivo de prueba para los operadores de Asignación Compuesta

System.out.println("--- Pruebas de Asignación Compuesta ---");

// --- Prueba con Enteros (int) ---
int a = 100;
System.out.println("Valor inicial de a: " + a); // 100

a += 20; // a = 100 + 20
System.out.println("a += 20  -> " + a); // Debería imprimir 120

a -= 50; // a = 120 - 50
System.out.println("a -= 50  -> " + a); // Debería imprimir 70

a *= 3; // a = 70 * 3
System.out.println("a *= 3   -> " + a); // Debería imprimir 210

a /= 10; // a = 210 / 10
System.out.println("a /= 10  -> " + a); // Debería imprimir 21

a %= 4; // a = 21 % 4
System.out.println("a %= 4   -> " + a); // Debería imprimir 1
System.out.println("");


// --- Prueba con Doubles (double) ---
double b = 20.0;
System.out.println("Valor inicial de b: " + b); // 20.0

b *= 2.5; // b = 20.0 * 2.5
System.out.println("b *= 2.5 -> " + b); // Debería imprimir 50.0

b /= 4.0; // b = 50.0 / 4.0
System.out.println("b /= 4.0 -> " + b); // Debería imprimir 12.5
System.out.println("");


// --- Prueba con Chars (char) ---
// El char 'd' tiene el valor ASCII 100
char letra = 'd';
System.out.println("Valor inicial de letra: " + letra); // 'd'

letra += 5; // letra = 100 + 5 = 105 (ASCII de 'i')
System.out.println("letra += 5 -> " + letra); // Debería imprimir 'i'

letra -= 2; // letra = 105 - 2 = 103 (ASCII de 'g')
System.out.println("letra -= 2 -> " + letra); // Debería imprimir 'g'
System.out.println("");


// --- Prueba de concatenación con String (+=) ---
String frase = "Hola";
System.out.println("Valor inicial de frase: " + frase); // "Hola"

frase += " Mundo";
System.out.println("frase += \" Mundo\" -> " + frase); // Debería imprimir "Hola Mundo"

frase += '!';
System.out.println("frase += '!'      -> " + frase); // Debería imprimir "Hola Mundo!"