// --- Archivo de Pruebas Completo: Aritméticos, Relacionales y Lógicos ---

System.out.println("--- Pruebas Relacionales ---");
int a = 10;
int b = 20;
double c = 10.0;
String s1 = "hola";
String s2 = "mundo";

System.out.println(a < b);      // Debe imprimir: true
System.out.println(a > b);      // Debe imprimir: false
System.out.println(a == c);     // Debe imprimir: true (compara valores numéricos)
System.out.println(a != b);     // Debe imprimir: true
System.out.println(b >= 20);    // Debe imprimir: true
System.out.println(s1 == "hola"); // Debe imprimir: true

System.out.println("--- Pruebas Lógicas ---");
boolean t = true;
boolean f = false;

System.out.println(t && f);     // Debe imprimir: false
System.out.println(t || f);     // Debe imprimir: true
System.out.println(!f);         // Debe imprimir: true
System.out.println(!t);         // Debe imprimir: false

System.out.println("--- Pruebas Combinadas ---");
// La precedencia de operadores debería resolver esto correctamente
System.out.println(a < b && s1 == "hola");  // true && true -> true
System.out.println(a > b || !f);            // false || true -> true
System.out.println(10 * 2 == 20);           // true

