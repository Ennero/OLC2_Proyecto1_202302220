// Archivo de prueba para TODOS los operadores de asignación

System.out.println("--- Pruebas de Asignación Aritmética ---");
int arit = 100;
System.out.println("Valor inicial de arit: " + arit); // 100
arit += 20;
System.out.println("arit += 20  -> " + arit);         // 120
arit -= 40;
System.out.println("arit -= 40  -> " + arit);         // 80
arit *= 2;
System.out.println("arit *= 2   -> " + arit);         // 160
arit /= 10;
System.out.println("arit /= 10  -> " + arit);         // 16
arit %= 5;
System.out.println("arit %= 5   -> " + arit);         // 1
System.out.println("");

System.out.println("--- Pruebas de Asignación a Nivel de Bits ---");
int bits = 15; // Binario: 0000 1111
int mascara = 25; // Binario: 0001 1001
System.out.println("Valor inicial de bits: " + bits); // 15
bits &= mascara; // 15 & 25 -> 9
System.out.println("bits &= 25  -> " + bits);         // 9
bits |= 18; // 9 | 18 (0001 0010) -> 27 (0001 1011)
System.out.println("bits |= 18  -> " + bits);         // 27
bits ^= 5; // 27 ^ 5 (0000 0101) -> 22 (0001 0110)
System.out.println("bits ^= 5   -> " + bits);         // 22
System.out.println("");

System.out.println("--- Pruebas de Asignación de Desplazamiento ---");
int shift = -16;
System.out.println("Valor inicial de shift: " + shift); // -16
shift <<= 2; // -16 * 4
System.out.println("shift <<= 2 -> " + shift);         // -64
shift >>= 3; // -64 / 8 (con signo)
System.out.println("shift >>= 3 -> " + shift);         // -8
// -8 en binario es ...1111 1000
// >>> 1 es 0...0111 1100 -> 2147483644
shift >>>= 1;
System.out.println("shift >>>= 1 -> " + shift);        // 2147483644
System.out.println("");

System.out.println("--- Prueba de Concatenación de String ---");
String frase = "Prueba";
frase += " ";
frase += "Exitosa";
frase += '!';
System.out.println(frase); // Debería imprimir "Prueba Exitosa!"