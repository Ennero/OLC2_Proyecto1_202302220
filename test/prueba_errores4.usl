// --- Ejemplos con Errores Semánticos (Parte 2) ---

// Objetivo: Probar la detección de redeclaración de variables.

// --- Prueba 1: Redeclaración en el ámbito global ---
int a = 10;
System.out.println(a);

int a = 20; // ERROR SEMÁNTICO: 'a' ya fue declarada en el ámbito 'global'.
// La ejecución debería detenerse aquí.

System.out.println(a); // Esta línea no debería ejecutarse.

// --- Prueba 2: Ocultamiento válido vs. Redeclaración inválida ---
// Este código no se ejecutará porque el error anterior detiene el programa,
// pero sirve para pruebas si comentas la primera parte.
int b = 100;

{
String b = "hola"; // VÁLIDO: Esta 'b' es local al bloque y "oculta" a la 'b' global.
System.out.println(b);

double b = 3.14; // ERROR SEMÁNTICO: 'b' ya fue declarada en ESTE ámbito ('global_bloque').

}

System.out.println(b);