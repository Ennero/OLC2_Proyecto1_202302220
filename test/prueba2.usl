// --- Ejemplo 3: Aritmética Avanzada y Precedencia ---

// Prueba de multiplicación y división
int a = 10 * 5; // 50
int b = 100 / 4; // 25
System.out.println(a);
System.out.println(b);

// Prueba de módulo
int c = 27 % 5; // 2
System.out.println(c);

// Prueba de precedencia de operadores
// Debería calcular (5 * 10) + (8 / 2) = 50 + 4 = 54
int resultado = 5 * 10 + 8 / 2;
System.out.println(resultado);

// Prueba con paréntesis para alterar la precedencia
// Debería calcular 100 / (2 + 8) = 100 / 10 = 10
int con_parentesis = 100 / (2 + 8);
System.out.println(con_parentesis);

// Prueba de división por cero (debería mostrar un error en la salida)
System.out.println(10 / 0);