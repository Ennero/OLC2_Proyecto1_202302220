// Archivo de prueba para el método .equals() en Strings

System.out.println("--- Pruebas de Comparación de Strings ---");

String s1 = "hola";
String s2 = "mundo";
String s3 = "hola";
int num = 123;

// --- Pruebas Válidas con .equals() ---

// 1. Comparación de dos strings con el mismo contenido
boolean resultado1 = s1.equals(s3);
System.out.println("'hola'.equals('hola') -> " + resultado1); // Debería ser true

// 2. Comparación de dos strings con contenido diferente
boolean resultado2 = s1.equals(s2);
System.out.println("'hola'.equals('mundo') -> " + resultado2); // Debería ser false

// 3. Se puede usar directamente con un literal
System.out.println("'hola'.equals(\"hola\") -> " + s1.equals("hola")); // Debería ser true
System.out.println("");


// --- Pruebas que DEBEN producir un Error Semántico ---

System.out.println("Las siguientes pruebas están comentadas porque deben generar errores:");

