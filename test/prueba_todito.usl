// --- Definición de Funciones Auxiliares ---

int sumar(int a, int b) {
    return a + b;
}

void saludar(String nombre) {
    System.out.println("Saludos, " + nombre);
}


public static void main(String[] args) {

    // ======================================================
    // PRUEBA 1: VARIABLES, EXPRESIONES Y OPERADORES
    // ======================================================
    System.out.println("--- INICIO: PRUEBAS DE EXPRESIONES ---");

    int a = 10 + (5 * 2);
    double b = 20.5 / 2.0;
    System.out.println(a); // Esperado: 20
    System.out.println(b); // Esperado: 10.25

    boolean p = true;
    boolean q = false;
    System.out.println(p && q); // Esperado: false
    System.out.println(p || q); // Esperado: true
    System.out.println(!p);     // Esperado: false

    int x = 13; // Binario: 1101
    int y = 10; // Binario: 1010
    System.out.println(x & y);  // Esperado: 8  (1000)
    System.out.println(x | y);  // Esperado: 15 (1111)
    System.out.println(y >> 1); // Esperado: 5  (0101)
    System.out.println(y << 1); // Esperado: 20 (10100)
    
    String saludo = "Hola";
    String mundo = "Mundo";
    System.out.println(saludo + " " + mundo + "!"); // Esperado: Hola Mundo!

    System.out.println("--- FIN: PRUEBAS DE EXPRESIONES ---\n");


    // ======================================================
    // PRUEBA 2: ESTRUCTURAS DE CONTROL
    // ======================================================
    System.out.println("--- INICIO: PRUEBAS DE CONTROL ---");

    int calificacion = 85;
    if (calificacion >= 90) {
        System.out.println("Excelente");
    } else if (calificacion >= 80) {
        System.out.println("Muy Bien"); // Esperado: Muy Bien
    } else {
        System.out.println("Aceptable");
    }

    int contador = 3;
    while (contador > 0) {
        System.out.println("Cuenta regresiva: " + contador);
        contador = contador - 1;
    } // Esperado: 3, 2, 1

    for (int i = 0; i < 5; i = i + 1) {
        if (i == 2) {
            continue; // Salta la iteración del 2
        }
        if (i == 4) {
            break; // Termina el bucle antes del 4
        }
        System.out.println("Iteracion For: " + i);
    } // Esperado: 0, 1, 3

    System.out.println("--- FIN: PRUEBAS DE CONTROL ---\n");


    // ======================================================
    // PRUEBA 3: FUNCIONES
    // ======================================================
    System.out.println("--- INICIO: PRUEBAS DE FUNCIONES ---");
    
    int resultadoSuma = sumar(15, 7);
    System.out.println(resultadoSuma); // Esperado: 22

    saludar("Mundo"); // Esperado: Saludos, Mundo

    System.out.println("--- FIN: PRUEBAS DE FUNCIONES ---\n");


    // ======================================================
    // PRUEBA 4: ARREGLOS (VECTORES Y MATRICES)
    // ======================================================
    System.out.println("--- INICIO: PRUEBAS DE ARREGLOS ---");
    
    // Declaración y creación
 // --- Definición de Funciones Auxiliares ---

int sumar(int a, int b) {
    return a + b;
}

void saludar(String nombre) {
    System.out.println("Saludos, " + nombre);
}


public static void main(String[] args) {

    // ======================================================
    // PRUEBA 1: VARIABLES, EXPRESIONES Y OPERADORES
    // ======================================================
    System.out.println("--- INICIO: PRUEBAS DE EXPRESIONES ---");

    int a = 10 + (5 * 2);
    double b = 20.5 / 2.0;
    System.out.println(a); // Esperado: 20
    System.out.println(b); // Esperado: 10.25

    boolean p = true;
    boolean q = false;
    System.out.println(p && q); // Esperado: false
    System.out.println(p || q); // Esperado: true
    System.out.println(!p);     // Esperado: false

    int x = 13; // Binario: 1101
    int y = 10; // Binario: 1010
    System.out.println(x & y);  // Esperado: 8  (1000)
    System.out.println(x | y);  // Esperado: 15 (1111)
    System.out.println(y >> 1); // Esperado: 5  (0101)
    System.out.println(y << 1); // Esperado: 20 (10100)
    
    String saludo = "Hola";
    String mundo = "Mundo";
    System.out.println(saludo + " " + mundo + "!"); // Esperado: Hola Mundo!

    System.out.println("--- FIN: PRUEBAS DE EXPRESIONES ---\n");


    // ======================================================
    // PRUEBA 2: ESTRUCTURAS DE CONTROL
    // ======================================================
    System.out.println("--- INICIO: PRUEBAS DE CONTROL ---");

    int calificacion = 85;
    if (calificacion >= 90) {
        System.out.println("Excelente");
    } else if (calificacion >= 80) {
        System.out.println("Muy Bien"); // Esperado: Muy Bien
    } else {
        System.out.println("Aceptable");
    }

    int contador = 3;
    while (contador > 0) {
        System.out.println("Cuenta regresiva: " + contador);
        contador = contador - 1;
    } // Esperado: 3, 2, 1

    for (int i = 0; i < 5; i = i + 1) {
        if (i == 2) {
            continue; // Salta la iteración del 2
        }
        if (i == 4) {
            break; // Termina el bucle antes del 4
        }
        System.out.println("Iteracion For: " + i);
    } // Esperado: 0, 1, 3

    System.out.println("--- FIN: PRUEBAS DE CONTROL ---\n");


    // ======================================================
    // PRUEBA 3: FUNCIONES
    // ======================================================
    System.out.println("--- INICIO: PRUEBAS DE FUNCIONES ---");
    
    int resultadoSuma = sumar(15, 7);
    System.out.println(resultadoSuma); // Esperado: 22

    saludar("Mundo"); // Esperado: Saludos, Mundo

    System.out.println("--- FIN: PRUEBAS DE FUNCIONES ---\n");


    // ======================================================
    // PRUEBA 4: ARREGLOS (VECTORES Y MATRICES)
    // ======================================================
    System.out.println("--- INICIO: PRUEBAS DE ARREGLOS ---");
    
    // Declaración y creación
    int[] miArreglo = new int[5];
    miArreglo[0] = 100;
    miArreglo[4] = 500;
    System.out.println(miArreglo[0]); // Esperado: 100
    System.out.println(miArreglo[1]); // Esperado: 0 (valor por defecto)
    System.out.println(miArreglo[4]); // Esperado: 500

    // Declaración con inicializador y estilo "C"
    double miVector[] = {1.1, 2.2, 3.3};
    System.out.println(miVector[1]); // Esperado: 2.2

    // Matriz (Arreglo 2D) con estilo mixto
    String[][] tablero = new String[2][2];
    tablero[0][0] = "A";
    tablero[1][1] = "B";
    System.out.println(tablero[0][0]); // Esperado: A
    System.out.println(tablero[0][1]); // Esperado: null (valor por defecto)
    
    int indice = 1;
    tablero[indice][indice] = "Cambiado";
    System.out.println(tablero[1][1]); // Esperado: Cambiado

    System.out.println("--- FIN: PRUEBAS DE ARREGLOS ---");
}


    miArreglo[0] = 100;
    miArreglo[4] = 500;
    System.out.println(miArreglo[0]); // Esperado: 100
    System.out.println(miArreglo[1]); // Esperado: 0 (valor por defecto)
    System.out.println(miArreglo[4]); // Esperado: 500

    // Declaración con inicializador y estilo "C"
    double miVector[] = {1.1, 2.2, 3.3};
    System.out.println(miVector[1]); // Esperado: 2.2

    // Matriz (Arreglo 2D) con estilo mixto
    String[][] tablero = new String[2][2];
    tablero[0][0] = "A";
    tablero[1][1] = "B";
    System.out.println(tablero[0][0]); // Esperado: A
    System.out.println(tablero[0][1]); // Esperado: null (valor por defecto)
    
    int indice = 1;
    tablero[indice][indice] = "Cambiado";
    System.out.println(tablero[1][1]); // Esperado: Cambiado

    System.out.println("--- FIN: PRUEBAS DE ARREGLOS ---");
}
