// --- Ejemplos con Errores Semánticos de Tipo ---

// Objetivo: Probar la detección de asignaciones con tipos incompatibles.

// --- Prueba 1: Error en la Declaración ---
// Se intenta asignar un String a una variable de tipo char.
int x = 10;
char c = "hola"; // ERROR SEMÁNTICO: No se puede asignar 'String' a 'char'.

print(x); // Esta línea no se ejecutará.

// --- Prueba 2: Error en la Reasignación ---
// Este código no se ejecutará por el error anterior,
// pero sirve para pruebas si se comenta la primera parte.
double pi = 3.14;
print(pi);

pi = 100; // ERROR SEMÁNTICO: No se puede asignar 'int' a 'double' (en nuestra implementación estricta).