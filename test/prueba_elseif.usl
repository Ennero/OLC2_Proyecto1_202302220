// Archivo de prueba para la estructura IF - ELSE IF - ELSE

System.out.println("--- Probando la estructura IF-ELSE IF-ELSE ---");

int nota = 75;
System.out.println("La nota del estudiante es: " + nota);

if (nota >= 90) {
    System.out.println("Calificación: A");
} else if (nota >= 80) {
    System.out.println("Calificación: B");
} else if (nota >= 70) {
    System.out.println("Calificación: C");
} else if (nota >= 60) {
    System.out.println("Calificación: D");
} else {
    System.out.println("Calificación: F");
}

System.out.println("--- Segunda prueba con otra nota ---");

nota = 92;
System.out.println("La nota del estudiante es: " + nota);

if (nota >= 90) {
    System.out.println("Calificación: A");
} else if (nota >= 80) {
    System.out.println("Calificación: B");
} else {
    System.out.println("Calificación: C o inferior");
}